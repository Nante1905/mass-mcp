# Modèle de configuration du serveur MCP.
#
#   cp .env.example .env
#
# Ce fichier ne contient aucun secret d'administration : le serveur MCP n'en
# détient pas. Il relaie le jeton de l'administrateur qui appelle — voir
# `src/auth/adminContext.ts`. Le seul identifiant qu'il porte est celui du rôle
# Postgres en lecture seule d'`query_analytics`.

# --- Écoute HTTP --------------------------------------------------------------
PORT=4000
HOST=0.0.0.0

# Origines autorisées à joindre `/mcp` depuis un navigateur, séparées par des
# virgules. Laissée vide, la protection contre le « DNS rebinding » reste
# désactivée : à ne faire qu'en développement, où le client est un script Python
# ou l'inspecteur MCP, jamais une page web.
MCP_ALLOWED_ORIGINS=

# --- API MASS -----------------------------------------------------------------
# Racine versionnée de l'API, celle que monte `mass-backend/src/index.ts`.
MASS_API_URL=http://localhost:3000/api/v1
MASS_API_TIMEOUT_MS=15000

# --- Base de lecture (query_analytics) ----------------------------------------
# Laissées vides, le serveur démarre quand même : seul `query_analytics`
# s'annonce indisponible. Les autres outils passent par l'API et n'ont pas
# besoin de la base.
#
# Ces identifiants doivent être ceux d'un rôle en lecture seule, pas ceux de
# l'API : voir `sql/readonly-role.sql`. Les garde-fous du code sont une seconde
# barrière, pas la première.
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_USER=mass_readonly
ANALYTICS_DB_PASSWORD=
ANALYTICS_DB_NAME=mass
ANALYTICS_DB_SSL=false

# Plafond de lignes rendues par requête, et délai au-delà duquel Postgres
# interrompt la requête. Une analyse conversationnelle n'a pas à rapporter
# 50 000 lignes dans un contexte de modèle, ni à tenir la base une minute.
ANALYTICS_MAX_ROWS=500
ANALYTICS_TIMEOUT_MS=5000
